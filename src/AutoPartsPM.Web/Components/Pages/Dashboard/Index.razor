@page "/"
@inject IMediator Mediator

@using AutoPartsPM.Application.Features.Dashboard.Queries.GetDashboardData

<PageTitle>ダッシュボード - AutoParts PM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ダッシュボード</MudText>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <!-- サマリーカード -->
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Large"
                            Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">全プロジェクト</MudText>
                            <MudText Typo="Typo.h4">@_data.TotalProjects</MudText>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Success" Size="Size.Large"
                            Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">進行中</MudText>
                            <MudText Typo="Typo.h4">@_data.ActiveProjects</MudText>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Size="Size.Large"
                            Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">完了</MudText>
                            <MudText Typo="Typo.h4">@_data.CompletedProjects</MudText>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Warning"
                            Color="@(_data.OverdueIssues > 0 ? Color.Error : Color.Default)"
                            Size="Size.Large" Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">期限超過課題</MudText>
                            <MudText Typo="Typo.h4"
                                Color="@(_data.OverdueIssues > 0 ? Color.Error : Color.Default)">
                                @_data.OverdueIssues
                            </MudText>
                        </div>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- プロジェクト一覧 + APQPフェーズ別 -->
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="8">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">最近のプロジェクト</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Href="/projects" Variant="Variant.Text" Color="Color.Primary">すべて表示</MudButton>
                        <MudButton Href="/projects/create" Variant="Variant.Filled" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">
                            新規作成
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@_projects.Take(5)" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>コード</MudTh>
                            <MudTh>プロジェクト名</MudTh>
                            <MudTh>顧客</MudTh>
                            <MudTh>フェーズ</MudTh>
                            <MudTh>進捗</MudTh>
                            <MudTh>ステータス</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="コード">
                                <MudLink Href="@($"/projects/{context.Id}")">@context.ProjectCode</MudLink>
                            </MudTd>
                            <MudTd DataLabel="プロジェクト名">@context.ProjectName</MudTd>
                            <MudTd DataLabel="顧客">@context.CustomerName</MudTd>
                            <MudTd DataLabel="フェーズ">
                                <MudChip T="string" Size="Size.Small" Color="GetPhaseColor(context.CurrentPhase)">
                                    @GetPhaseName(context.CurrentPhase)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="進捗">
                                <MudProgressLinear Color="Color.Primary" Value="@((double)context.OverallProgress)"
                                    Class="my-1" />
                                <MudText Typo="Typo.caption">@context.OverallProgress.ToString("F0")%</MudText>
                            </MudTd>
                            <MudTd DataLabel="ステータス">
                                <MudChip T="string" Size="Size.Small" Color="GetStatusColor(context.Status)">
                                    @GetStatusName(context.Status)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- APQPフェーズ別集計 -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">APQPフェーズ別（進行中）</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @foreach (APQPPhase phase in Enum.GetValues<APQPPhase>())
                    {
                        var count = _data.PhaseDistribution.TryGetValue(phase, out var c) ? c : 0;
                        <div class="d-flex justify-space-between align-center mb-3">
                            <MudText Typo="Typo.body2">@GetPhaseName(phase)</MudText>
                            <MudChip T="string" Size="Size.Small" Color="GetPhaseColor(phase)">@count 件</MudChip>
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- 直近マイルストーン + 期限超過課題 -->
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6">直近7日のマイルストーン</MudText>
                            @if (_data.UpcomingMilestones > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                    @_data.UpcomingMilestones 件
                                </MudChip>
                            }
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_data.UpcomingMilestoneList.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">直近7日以内のマイルストーンはありません</MudText>
                    }
                    else
                    {
                        <MudList T="UpcomingMilestoneDto" Dense="true">
                            @foreach (var ms in _data.UpcomingMilestoneList)
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div>
                                            <MudLink Href="@($"/projects/{ms.ProjectId}")">
                                                <MudText Typo="Typo.body2">@ms.ProjectName</MudText>
                                            </MudLink>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ms.Name</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                            @ms.DueDate.ToString("MM/dd")
                                        </MudChip>
                                    </div>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6">期限超過課題</MudText>
                            @if (_data.OverdueIssues > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                    @_data.OverdueIssues 件
                                </MudChip>
                            }
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_data.OverdueIssueList.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">期限超過の課題はありません</MudText>
                    }
                    else
                    {
                        <MudList T="OverdueIssueDto" Dense="true">
                            @foreach (var issue in _data.OverdueIssueList)
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div>
                                            <MudLink Href="@($"/projects/{issue.ProjectId}")">
                                                <MudText Typo="Typo.body2">@issue.ProjectName</MudText>
                                            </MudLink>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@issue.Title</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="GetPriorityColor(issue.Priority)">
                                            @GetPriorityName(issue.Priority)
                                        </MudChip>
                                    </div>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private List<ProjectListDto> _projects = new();
    private DashboardDataDto _data = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var projectsTask = Mediator.Send(new GetProjectListQuery());
        var dashboardTask = Mediator.Send(new GetDashboardDataQuery());
        await Task.WhenAll(projectsTask, dashboardTask);
        _projects = projectsTask.Result;
        _data = dashboardTask.Result;
        _loading = false;
    }

    private static string GetPhaseName(APQPPhase phase) => phase switch
    {
        APQPPhase.Planning => "計画・定義",
        APQPPhase.ProductDesign => "製品設計",
        APQPPhase.ProcessDesign => "工程設計",
        APQPPhase.Validation => "妥当性確認",
        APQPPhase.Production => "量産",
        _ => phase.ToString()
    };

    private static Color GetPhaseColor(APQPPhase phase) => phase switch
    {
        APQPPhase.Planning => Color.Info,
        APQPPhase.ProductDesign => Color.Primary,
        APQPPhase.ProcessDesign => Color.Secondary,
        APQPPhase.Validation => Color.Warning,
        APQPPhase.Production => Color.Success,
        _ => Color.Default
    };

    private static string GetStatusName(ProjectStatus status) => status switch
    {
        ProjectStatus.Draft => "下書き",
        ProjectStatus.Active => "進行中",
        ProjectStatus.OnHold => "保留",
        ProjectStatus.Completed => "完了",
        ProjectStatus.Cancelled => "中止",
        _ => status.ToString()
    };

    private static Color GetStatusColor(ProjectStatus status) => status switch
    {
        ProjectStatus.Draft => Color.Default,
        ProjectStatus.Active => Color.Success,
        ProjectStatus.OnHold => Color.Warning,
        ProjectStatus.Completed => Color.Info,
        ProjectStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static string GetPriorityName(IssuePriority p) => p switch
    {
        IssuePriority.Low => "低", IssuePriority.Medium => "中",
        IssuePriority.High => "高", IssuePriority.Critical => "最重要",
        _ => p.ToString()
    };

    private static Color GetPriorityColor(IssuePriority p) => p switch
    {
        IssuePriority.Low => Color.Default, IssuePriority.Medium => Color.Info,
        IssuePriority.High => Color.Warning, IssuePriority.Critical => Color.Error,
        _ => Color.Default
    };
}
